# 模型接入配置示例 —— 推荐直接用界面「设置」（密钥存用户配置目录，不在项目内）。
# 也可复制成 .env（已在 .gitignore）。优先级：界面保存的字段 > 环境变量/.env > 服务商预设。
# 环境变量里的密钥只会发往环境变量里的地址（防止把 A 家的 key 发给 B 家）。

# 默认：Inception Mercury（OpenAI 兼容，128k 上下文，无嵌入接口 → 只用 BM25）
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_MODEL=mercury-3
LLM_API_KEY=

# 示例：DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 示例：本地 Ollama（不需要密钥）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# 可选：嵌入检索（不填 = 只用 BM25）。EMBED_API_KEY 只发往 EMBED_BASE_URL。
# EMBED_MODEL=text-embedding-v3
# EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBED_API_KEY=

# 部署：允许的 Host 头（防 DNS rebinding；默认只允许本机）。逗号分隔，支持 *.example.com
# CONVTREE_ALLOWED_HOSTS=3000-xxxx.instabox.tech
# URL 入库默认禁止抓本机/内网；确需抓局域网资料站时逐个放行 host 或 host:port
# CONVTREE_URL_ALLOWLIST=192.168.1.10:8080
# 分支上下文字符预算（超出的远祖先换成摘要）
# CONTEXT_BUDGET_CHARS=24000
